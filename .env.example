# Copy to .env.local to override. Optional — the app runs without it.

# Base URL of the nuMoni Gateway (see specs/numoni.json), used by the browser
# API client and the /api/auth/* route handlers. Defaults to the URL below.
# Kong: http://localhost:8000/v1
NEXT_PUBLIC_API_URL=https://numoni-gateway-ms.fly.dev

# Mocking mode, sign-in mocking and mock latency are set in src/lib/config.ts.
